# Copy to .env.local and restart `npm run dev` (or rebuild) after changing.

# Colour theme: emerald | ruby | sapphire | violet | midnight | rose | sunset | ocean | forest | coffee
SITE_THEME=emerald
# true = force this theme (hides the theme picker, ignores a visitor's saved choice)
SITE_THEME_LOCK=false

# Sign-up: true = open, false = closed (hides register buttons/links, /register/ shows a closed notice, API refuses)
SITE_REGISTER=true

# Backend API base URL: one value for both server and browser (default below)
NEXT_PUBLIC_API_URL=
